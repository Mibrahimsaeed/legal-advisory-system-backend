# --- App ---
APP_NAME=legal-chatbot-api
APP_ENV=development
DEBUG=true

# --- Database ---
# Quick-start option (no install needed): SQLite, stored as a local file
DATABASE_URL=sqlite+aiosqlite:///./app.db
# Production option (needs Postgres running):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/legal_chatbot

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Auth / JWT ---
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- File Uploads ---
MAX_UPLOAD_SIZE_MB=20

# --- CORS ---
# Comma-separated allowed frontend origins. "*" for quick tests;
# set real domains in production, e.g. https://myapp.com,https://www.myapp.com
# The web app runs on http://localhost:3000 in development.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Google sign-in (optional) ---
# Comma-separated OAuth client IDs from Google Cloud Console. Empty = disabled.
GOOGLE_CLIENT_IDS=

# --- Email for password-reset / email-change codes (optional) ---
# Leave SMTP_* empty in development: codes are printed in the backend terminal.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=no-reply@example.com
# PASSWORD_RESET_CODE_MINUTES=15

# --- Case law data folder (.json / .jsonl / .csv files) ---
CASE_LAW_DATA_DIR=data/case_law
